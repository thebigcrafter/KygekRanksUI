{
    "name": "thebigcrafter/kygekranksui",
    "description": "A PocketMine-MP plugin that shows information about ranks in the server",
    "license": "GPL-3.0-only",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vecnavium/FormsUI"
        },
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/Hydrogen"
        }
    ],
    "require": {
        "vecnavium/formsui": "dev-master",
        "thebigcrafter/hydrogen": "^1.1.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.17",
        "phpstan/phpstan": "^2.1",
        "axolotl-pm/pocketmine-mp": "5.49.1"
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "thebigcrafter\\Hydrogen\\": "tools/stubs/Hydrogen/",
            "Vecnavium\\FormsUI\\": "tools/stubs/FormsUI/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse -c phpstan.neon.dist"
    }
}
